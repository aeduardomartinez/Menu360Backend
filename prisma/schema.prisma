datasource db {
  provider = "postgresql"

  // Supabase expone dos puertos distintos y hacen falta los dos.
  //
  // DATABASE_URL apunta al pooler en modo transacción (puerto 6543). Es el que
  // usa la aplicación: reparte muchas conexiones cortas entre pocas reales, que
  // es lo que necesita un servidor web. Además es IPv4, mientras que la conexión
  // directa (db.<ref>.supabase.co) es solo IPv6 en el plan gratuito y desde
  // Render no se alcanza.
  //
  // DIRECT_URL apunta al pooler en modo sesión (puerto 5432) y solo lo usan las
  // migraciones: `prisma migrate deploy` necesita bloqueos de aviso y sentencias
  // preparadas que el modo transacción no soporta, así que contra el 6543
  // fallaría. Prisma decide sola cuál usar en cada caso.
  //
  // En local define DIRECT_URL en tu .env con el mismo valor que DATABASE_URL:
  // si falta, Prisma se queja de que la variable no existe.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Almacena la configuración principal de cada Restaurante (Multi-Tenant).
/// Contiene datos de personalización, horarios, redes sociales y preferencias del local.
model Restaurant {
  id                String   @id @default(uuid())
  slug              String   @unique
  name              String
  logoUrl           String?
  themeColor        String
  adminThemeColor   String?
  welcomeMessage    String?
  description       String?  @db.Text
  address           String?
  neighborhood      String?
  city              String?
  heroImageUrl      String?
  fontFamily        String?
  borderRadius      String?
  isDarkMode        Boolean?
  categoryNavStyle  String?  @default("tabs")
  heroStyle         String?  @default("cover")
  instagramUrl      String?
  facebookUrl       String?
  tiktokUrl         String?
  whatsappPhone     String?
  couponsEnabled    Boolean? @default(false)
  deliveryConfig    Json?
  estimatedDeliveryTime String?
  minimumOrderAmount    Float?
  schedule              Json?
  titleEffect           String?  @default("animate-none")
  iconColor             String?  @default("#facc15")
  iconStyle             String?  @default("outline")

  // ─── Apariencia del menú del cliente ────────────────────────────────────
  // Menú 360 sirve a muchos restaurantes a la vez, así que la meta de estos
  // campos es que dos tiendas no se parezcan: cada uno cambia una decisión
  // visual distinta (color, tipografía, forma, densidad, fondo), y entre
  // todos dan combinaciones muy diferentes sin tocar código.
  //
  // buttonStyle ya lo enviaba el panel de administración desde hace rato,
  // pero no existía la columna, así que el valor se perdía en cada guardado:
  // el cliente siempre veía botones sólidos por más que se eligiera
  // "bordeado". Lo mismo pasaba con productViewStyle y cartStyle, que además
  // no los leía ninguna pantalla; esos dos se quitaron del panel y se
  // reemplazaron por productCardStyle, que sí cambia la vista de verdad.
  accentColor           String?  @default("#0d6efd")  // Color de precios y acentos
  buttonStyle           String?  @default("solid")    // 'solid' | 'outline'
  productCardStyle      String?  @default("horizontal") // 'horizontal' | 'vertical' | 'compact'
  cardShadow            String?  @default("soft")     // 'none' | 'soft' | 'strong'
  sectionTitleStyle     String?  @default("plain")    // 'plain' | 'underline' | 'bar' | 'centered'
  pageBackground        String?  @default("light")    // 'light' | 'warm' | 'cool' | 'slate' | 'dark'
  headingFont           String?  @default("inherit")  // tipografía solo para títulos
  // Estructura de la carta. Estos cinco son los que de verdad hacen que dos
  // menús no se parezcan: el color se cambia en un segundo, pero un menú de
  // renglones con línea de puntos y uno de tarjetas con foto grande son dos
  // objetos distintos aunque compartan la paleta.
  itemLayout            String?  @default("card")      // 'card' | 'divider' | 'boxed'
  priceStyle            String?  @default("accent")    // 'accent' | 'plain' | 'chip' | 'leader'
  nameStyle             String?  @default("normal")    // 'normal' | 'uppercase' | 'spaced'
  density               String?  @default("normal")    // 'compact' | 'normal' | 'relaxed'
  imageShape            String?  @default("rounded")   // 'rounded' | 'square' | 'circle' | 'none'
  kitchenAlertMinutes   Int?     @default(15)
  planType              String   @default("ADVANCED") // 'BASIC' | 'ADVANCED'
  taxType               String?  @default("NONE")     // 'INC' | 'IVA' | 'NONE'
  taxRate               Float?   @default(0)          // e.g., 0.08, 0.19
  paymentStatus         String?  @default("PAID")     // 'PAID' | 'PENDING'
  paymentFrequency      String?  @default("MONTHLY")  // 'MONTHLY' | 'QUARTERLY'
  paymentAmount         Float?   @default(0)
  isBlocked             Boolean? @default(false)
  acceptedPaymentMethods String[] @default(["Efectivo", "Transferencia", "Tarjeta"])
  // Cuentas bancarias / billeteras (Nequi, Daviplata, Bancolombia, etc.) que se
  // muestran al cliente cuando elige "Transferencia" como medio de pago, para
  // que sepa a qué cuenta consignar sin depender de que se lo digan por
  // WhatsApp. Se guarda como Json (en vez de una tabla propia) porque es
  // configuración de bajo volumen que siempre se lee junto con el restaurante,
  // igual que deliveryConfig y schedule.
  paymentAccounts        Json?    @default("[]")
  // Controlado únicamente desde el panel supremo (SuperAdmin): ya no depende
  // del plan (BASIC/ADVANCED), sino de que el SUPERADMIN active la
  // facturación electrónica DIAN para esta tienda en particular. Por defecto
  // queda desactivada para toda tienda nueva o existente hasta que se
  // active explícitamente.
  eInvoiceEnabled       Boolean? @default(false)

  users             User[]
  boxes             Box[]
  categories        Category[]
  products          Product[]
  orders            Order[]
  financialRecords  FinancialRecord[]
  invoices          Invoice[]
  modifierCategories ModifierCategory[]
  coupons           Coupon[]
  boxSessions       BoxSession[]
  tables            Table[]
  clients           Client[]
}

/// Gestiona los usuarios del sistema que operan el restaurante.
/// Almacena credenciales, roles (Admin, Cajero, Mesero) y datos personales del staff.
model User {
  id           String      @id @default(uuid())
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  name         String?
  lastName     String?
  email        String     @unique
  phone        String?
  vehiclePlate String?
  passwordHash String
  role         String     // 'SUPERADMIN' | 'ADMIN' | 'CASHIER' | 'DELIVERY'
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  boxes        Box[]        @relation("AssignedBoxes")
  boxSessions  BoxSession[]
  orders       Order[]      @relation("WaitressOrders")
}

/// Representa una Caja Registradora física o virtual dentro del restaurante.
/// Guarda el estado actual de la caja (abierta/cerrada) y el balance de dinero en curso.
model Box {
  id             String     @id @default(uuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id])
  name           String
  description    String?
  assignedUserId String?
  assignedUser   User?      @relation("AssignedBoxes", fields: [assignedUserId], references: [id])
  status         String     // 'OPEN' | 'CLOSED'
  openedAt       DateTime?
  closedAt       DateTime?
  currentBalance Float      @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  sessions       BoxSession[]
}

/// Registra el historial de turnos o jornadas de cada Caja Registradora.
/// Almacena con cuánto dinero abre, cuánto se factura en el sistema y los descuadres al cerrar.
model BoxSession {
  id             String     @id @default(uuid())
  boxId          String
  box            Box        @relation(fields: [boxId], references: [id])
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id])
  userId         String?
  user           User?      @relation(fields: [userId], references: [id])
  openedAt       DateTime
  closedAt       DateTime
  initialBalance Float
  systemBalance  Float
  manualCount    Float
  difference     Float
  comments       String?    @db.Text
  createdAt      DateTime   @default(now())
}

/// Clasifica los productos del menú (Ej: Bebidas, Platos Fuertes, Postres).
/// Guarda el nombre de la categoría y el orden en el que se muestra en el menú digital.
model Category {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  orderIndex   Int
}

/// Contiene el catálogo de ítems a la venta en el restaurante.
/// Almacena precios, imágenes, descripciones, control de inventario y modificadores permitidos.
model Product {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  description  String?    @db.Text
  price        Float
  category     String
  /// URL en Firebase Storage. La imagen ya no se guarda acá dentro: antes
  /// era un data URL en base64 y la carta entera viajaba en cada carga.
  imageUrl     String
  /// Versión de 400px para las tarjetas de la carta. El detalle del plato
  /// usa imageUrl. Opcional porque no todas las imágenes tienen miniatura.
  thumbnailUrl String?
  isAvailable  Boolean    @default(true)
  trackStock   Boolean    @default(false)
  currentStock Int?

  isFeatured   Boolean?   @default(false)
  variants     Json?
  modifierIds  String[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

/// Registra las ventas y pedidos realizados por los clientes.
/// Guarda los productos comprados, datos de entrega, total a pagar, método de pago y estado del pedido.
model Order {
  id              String     @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id])
  clientName      String
  clientPhone     String
  clientDocument  String?
  items           Json
  totalAmount     Float
  status          String
  paymentMethod   String
  isPaid          Boolean    @default(false)
  deliveryAddress String?
  deliveryType    String?
  neighborhood    String?
  city            String?
  orderComments   String?    @db.Text
  origin          String?
  orderNumber     Int?
  driverId        String?
  tableId         String?
  table           Table?     @relation(fields: [tableId], references: [id])
  waitressId      String?
  waitress        User?      @relation("WaitressOrders", fields: [waitressId], references: [id])
  driverConfirmedCash Boolean @default(false)
  // Transferencia verificada por el cajero: el dinero ya llegó a la cuenta
  // del restaurante, pero el pedido TODAVÍA no se ha facturado. Es un paso
  // intermedio propio de los domicilios web pagados por transferencia: es lo
  // que habilita marcar el pedido "Listo para entrega", y recién al
  // facturarlo (isPaid) la venta se registra en caja y suma a las ventas del
  // día. Por eso no alcanza con isPaid para modelar esto: entre "el pago
  // llegó" y "el pedido se facturó" pueden pasar varios minutos (lo que
  // tarde la cocina).
  transferConfirmed Boolean @default(false)
  // Momento en que el restaurante aceptó un pedido que llegó de la web.
  // Aceptar NO lo manda a cocina: el pedido sigue "Pendiente" hasta que
  // alguien lo pase a "En preparación" a mano, cuando de verdad empiezan a
  // hacerlo. Este campo solo distingue "pedido web sin revisar" (hay que
  // aceptarlo o rechazarlo) de "pedido ya aceptado, esperando que lo
  // preparen"; sin él, ambos casos se verían igual en el historial.
  acceptedAt      DateTime?
  invoices        Invoice[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Índices para acelerar las consultas más frecuentes: listar/filtrar por
  // fecha (panel de administración), calcular el siguiente número de pedido
  // al crear uno nuevo, y listar las entregas de un domiciliario.
  @@index([restaurantId, createdAt])
  @@index([restaurantId, orderNumber])
  @@index([restaurantId, driverId])
  @@index([restaurantId, status])
}

/// Define las mesas físicas disponibles en el restaurante.
/// Almacena la capacidad de comensales y permite asociar pedidos directamente a una mesa.
model Table {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  capacity     Int?
  isActive     Boolean    @default(true)
  orders       Order[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

/// Historial de movimientos financieros (Ingresos y Egresos).
/// Útil para la contabilidad del restaurante, guardando el concepto, monto y método de pago.
model FinancialRecord {
  id            String     @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  type          String     // 'INCOME' | 'EXPENSE'
  amount        Float
  category      String
  date          DateTime   @default(now())
  boxName       String?
  boxId         String?
  paymentMethod String?
  description   String?
  createdAt     DateTime   @default(now())
}

/// Registra las Facturas Electrónicas generadas (Integración DIAN).
/// Almacena el cliente facturado, los montos totales, impuestos e identificadores tributarios.
model Invoice {
  id            String     @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  orderId       String
  order         Order      @relation(fields: [orderId], references: [id])
  clientName    String
  clientNit     String
  clientEmail   String
  clientPhone   String?
  totalAmount   Float
  status        String
  dianUrl       String?
  cufe          String?
  issuedAt      DateTime   @default(now())
}

/// Agrupa opciones o variaciones que se le pueden añadir a un producto (Ej: "Término de la carne", "Salsas extra").
/// Define si la elección es obligatoria, única o múltiple.
model ModifierCategory {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  selection    String     // 'SINGLE' | 'MULTIPLE'
  isRequired   Boolean
  options      Json
}

/// Sistema de promociones y descuentos.
/// Almacena los códigos de cupones, el porcentaje de descuento y si están activos o expirados.
model Coupon {
  id                 String     @id @default(uuid())
  restaurantId       String
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id])
  code               String
  discountPercentage Float
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([restaurantId, code])
}

/// Base de datos de Clientes frecuentes y datos para facturación.
/// Guarda información de contacto e información tributaria (NIT, Régimen) para autocompletado en facturas.
model Client {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name             String
  phone            String?
  email            String?
  birthDate        DateTime?
  documentType     String? // Cédula, NIT, etc.
  documentId       String? // Número
  dv               String?
  regime           String?
  responsibilities String?
  department       String?
  city             String?
  address          String?
  neighborhood     String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // Teléfono y cédula/NIT son los identificadores reales de un cliente: dos
  // clientes del mismo restaurante no pueden compartir ni el mismo teléfono
  // ni el mismo documento (Postgres permite múltiples NULL, así que un
  // cliente sin teléfono o sin documento registrado no se ve afectado). Esto
  // cierra a nivel de base de datos el hueco que dejaba la validación previa,
  // que solo vivía en el código y no protegía contra condiciones de carrera.
  @@unique([restaurantId, phone])
  @@unique([restaurantId, documentId])
}

